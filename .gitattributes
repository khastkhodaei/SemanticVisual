# Auto-detect text files and normalize line endings
* text=auto

# Explicit text files with LF
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Windows scripts with CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.pt binary
*.bin binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg text
